---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown>;
  ogImage?: string;
}

const { title, description, jsonLd, ogImage } = Astro.props;
---
<BaseLayout title={title} description={description} jsonLd={jsonLd} ogImage={ogImage}>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</BaseLayout>
