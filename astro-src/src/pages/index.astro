  <!-- ===== OM OSS BLOCK ===== -->
  <section class="section-gap" aria-label="Om Bellums">
    <div class="container">
      <div class="about-block">
        <div class="about-block__image fade-in">
          <img
            src="/images/kund/bellums-golvlaggning-lagenhet.webp"
            alt="Bellums hantverkare lägger golv i lägenhet"
            width="600"
            height="480"
            loading="lazy"
            decoding="async"
          />
