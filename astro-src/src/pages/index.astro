---
import PageLayout from '../layouts/PageLayout.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Bellums Volym Två AB",
  "description": "Golvslippning, lackering och hantverk i Stockholm med omnejd. 2 års garanti. F-skatt godkänd.",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Honörsgatan 6",
    "postalCode": "17069",
    "addressLocality": "Solna",
    "addressCountry": "SE"
  },
  "telephone": "+46709122589",
  "email": "hampus@bellums.se",
  "url": "https://bellums.se/",
  "openingHours": ["Mo-Fr 06:00-19:00", "Sa 09:00-16:00"],
  "priceRange": "$$",
  "sameAs": [
    "https://www.instagram.com/bellumsgrupp/",
    "https://www.tiktok.com/@bellumsgrupp",
    "https://se.pinterest.com/Bellumsbolag/"
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.25",
    "reviewCount": "53",
    "bestRating": "5"
  }
};
---

<PageLayout
  title="Golvslippning Stockholm – Bellums Volym Två AB"
  description="Vi slipar och lackerar trägolv, lägger nytt golv och renoverar hem i Stockholm, Danderyd, Östermalm och Sollentuna. Kostnadsfri offert. 2 års garanti. F-skatt."
  jsonLd={jsonLd}
>

  <!-- ===== HERO ===== -->
  <section class="hero" aria-label="Introduktion">
    <img
      src="/images/kund/bellums-team-renovering-lagenhet.webp"
      alt="Bellums hantverkare arbetar i lägenhet i Stockholm"
      class="hero__bg"
      width="1260"
      height="945"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="container">
      <div class="hero__content">
        <span class="hero__label">Golvslippning &amp; Hantverk</span>
        <h1>Golvslippning och hantverk i Stockholm</h1>
        <p>Vi slipar och lackerar trägolv, lägger nytt golv och renoverar hem i Stockholmsregionen. Kostnadsfri offert – svar inom 24 timmar.</p>
        <div class="hero__ctas">
          <a href="/kontakt" class="btn btn-primary">Begär offert</a>
          <a href="/om-oss" class="btn btn-secondary">Läs om oss</a>
