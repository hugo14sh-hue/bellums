          <a href="/golvslippning-stockholm" class="link">Läs mer <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6z"/></svg></a>
        </div>
        <div class="service-card fade-in">
