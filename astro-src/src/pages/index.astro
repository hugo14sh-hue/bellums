    <div class="container">
      <div class="fun-facts__grid">
        <div class="fact-card fade-in">
          <span class="counter" data-target="53">0</span>
          <span class="label">Slutförda uppdrag</span>
        </div>
        <div class="fact-card fade-in">
          <span class="counter" data-target="4" data-suffix=",25/5">4,25/5</span>
