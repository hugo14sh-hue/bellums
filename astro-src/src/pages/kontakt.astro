---
import PageLayout from '../layouts/PageLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<PageLayout
  title="Kontakt – Bellums Volym Två AB | Begär offert"
  description="Kontakta Bellums för offert på golvslippning, lackering eller hantverk i Stockholm. Svar inom 24 timmar. Ring 070-912 25 89 eller fyll i formuläret."
  ogImage="/images/kund/bellums-fasadrenovering-utomhus.webp"
>

  <!-- Breadcrumb hero -->
  <section class="breadcrumb-hero" aria-label="Kontakta oss">
    <img
      src="/images/kund/bellums-fasadrenovering-utomhus.webp"
      alt="Bellums hantverkare arbetar utomhus"
      class="breadcrumb-hero__bg"
      width="1200"
      height="800"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="container">
      <div class="breadcrumb-hero__content">
        <h1>Kontakta oss</h1>
        <nav class="breadcrumb-nav" aria-label="Brödsmulor">
          <a href="/">Hem</a>
          <span class="sep" aria-hidden="true">›</span>
          <span class="current">Kontakt</span>
        </nav>
      </div>
    </div>
  </section>

  <!-- Kontaktlayout -->
  <section class="section-gap">
    <div class="container">
      <div class="contact-layout">

        <!-- Kontaktinfo vänster -->
        <div class="contact-info fade-in">
          <h2>Kom i kontakt</h2>
          <p style="color:var(--color-grey-text);margin-bottom:2rem;">Vi svarar på offertförfrågningar inom 24 timmar på vardagar. Välkommen att ringa, maila eller fylla i formuläret.</p>

          <div class="contact-info-list">
            <div class="contact-info-item">
              <div class="icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
              </div>
              <div class="text">
                <h5>Telefon</h5>
                <a href="tel:+46709122589">070-912 25 89</a>
              </div>
            </div>

            <div class="contact-info-item">
              <div class="icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
              </div>
              <div class="text">
                <h5>E-post</h5>
                <a href="mailto:hampus@bellums.se">hampus@bellums.se</a>
              </div>
            </div>

            <div class="contact-info-item">
              <div class="icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
              </div>
              <div class="text">
                <h5>Adress</h5>
                <p>Honörsgatan 6<br>17069 Solna</p>
                <a href="https://maps.app.goo.gl/m5UekaxRWM2Hb9MR8" target="_blank" rel="noopener noreferrer" style="font-size:0.875rem;">Hitta oss på Google Maps →</a>
              </div>
            </div>

            <div class="contact-info-item">
              <div class="icon">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/></svg>
              </div>
              <div class="text">
                <h5>Öppettider</h5>
                <p>Måndag–fredag: 06:00–19:00<br>Lördag: 09:00–16:00<br>Söndag: Stängt</p>
              </div>
            </div>
          </div>

          <div class="contact-social" aria-label="Sociala medier">
            <a href="https://www.instagram.com/bellumsgrupp/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
            <a href="https://www.tiktok.com/@bellumsgrupp" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.28 8.28 0 004.84 1.55V6.78a4.85 4.85 0 01-1.07-.09z"/></svg>
            </a>
            <a href="https://se.pinterest.com/Bellumsbolag/" target="_blank" rel="noopener noreferrer" aria-label="Pinterest">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg>
            </a>
          </div>
        </div>

        <!-- Formulär höger -->
        <div class="fade-in">
          <ContactForm />
        </div>

      </div>

      <!-- Karta -->
      <div class="map-wrapper">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2031.3!2d17.99!3d59.36!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zSG9uw7Zyc2dhdGFuIDYsIDE3MDY5IFNvbG5h!5e0!3m2!1ssv!2sse!4v1"
          width="600"
          height="400"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Bellums Volym Två AB på kartan – Honörsgatan 6, Solna"
        ></iframe>
      </div>

    </div>
  </section>

  <!-- ===== RELATERADE TJÄNSTER ===== -->
  <section class="local-links section-gap" aria-label="Våra tjänster och områden">
    <div class="container">
      <div class="section-title text-center">
        <span class="label">Våra tjänster</span>
        <h2>Vad kan vi hjälpa dig med?</h2>
        <p>Vi utför golvslippning och hantverk i hela Stockholmsregionen – kostnadsfri offert, svar inom 24 timmar.</p>
      </div>
      <div class="local-links__grid">
        <a href="/golvslippning-stockholm" class="local-link-card">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M20 7H4c-1.1 0-2 .9-2 2v6c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V9c0-1.1-.9-2-2-2zm-1 7H5V9h14v5z"/></svg>
          Golvslippning Stockholm
        </a>
        <a href="/hantverkare-stockholm" class="local-link-card">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/></svg>
          Hantverkare Stockholm
        </a>
        <a href="/golvslippning-danderyd" class="local-link-card">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          Golvslippning Danderyd
        </a>
        <a href="/golvslippning-ostermalm" class="local-link-card">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          Golvslippning Östermalm
        </a>
        <a href="/golvslippning-sollentuna" class="local-link-card">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
          Golvslippning Sollentuna
        </a>
        <a href="/om-oss" class="local-link-card">
          <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/></svg>
          Om Bellums Volym Två AB
        </a>
      </div>
    </div>
  </section>

</PageLayout>

<script>
  const fadeEls = document.querySelectorAll('.fade-in');
  if (fadeEls.length > 0) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    fadeEls.forEach(el => observer.observe(el));
  }
</script>
